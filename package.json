{
	"name": "@orochibraru/ui",
	"version": "0.0.0",
	"description": "Svelte 5 components and theme shared by OpenCount, LocalAssistant, Homerun, Sergio's, Nuvio Web and Penombre.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orochibraru/ui.git"
	},
	"type": "module",
	"bin": {
		"orochibraru-ui-mcp": "dist/mcp.js"
	},
	"packageManager": "bun@1.4.4",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./theme.css": "./dist/theme.css",
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./appearance": {
			"types": "./dist/appearance.d.ts",
			"default": "./dist/appearance.js"
		},
		"./toast": {
			"types": "./dist/toast.d.ts",
			"default": "./dist/toast.js"
		},
		"./password": {
			"types": "./dist/password.d.ts",
			"default": "./dist/password.js"
		},
		"./server/logger": {
			"types": "./dist/server/logger.d.ts",
			"default": "./dist/server/logger.js"
		},
		"./server/telemetry": {
			"types": "./dist/server/telemetry.d.ts",
			"default": "./dist/server/telemetry.js"
		},
		"./server/hooks": {
			"types": "./dist/server/hooks.d.ts",
			"default": "./dist/server/hooks.js"
		},
		"./haptics": {
			"types": "./dist/haptics.d.ts",
			"default": "./dist/haptics.js"
		},
		"./page-title": {
			"types": "./dist/page-title.svelte.d.ts",
			"svelte": "./dist/page-title.svelte.js"
		},
		"./components/*": {
			"types": "./dist/components/kit/*.svelte.d.ts",
			"svelte": "./dist/components/kit/*.svelte"
		},
		"./blocks/*": {
			"types": "./dist/components/blocks/*.svelte.d.ts",
			"svelte": "./dist/components/blocks/*.svelte"
		},
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package && bun scripts/build-mcp.ts && publint --strict",
		"build:docs": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "bun fmt",
		"lint": "prek run --all-files",
		"test": "svelte-kit sync && bun test tests/unit --timeout 120000",
		"prepack": "bun run build",
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true && prek install --allow-missing-config || true"
	},
	"peerDependencies": {
		"@opentelemetry/context-async-hooks": "^3.0.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
		"@opentelemetry/resources": "^3.0.0",
		"@opentelemetry/sdk-trace": "^3.0.0",
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.0"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/context-async-hooks": {
			"optional": true
		},
		"@opentelemetry/exporter-trace-otlp-proto": {
			"optional": true
		},
		"@opentelemetry/resources": {
			"optional": true
		},
		"@opentelemetry/sdk-trace": {
			"optional": true
		}
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.64.0",
		"@opentelemetry/api": "^1.10.0",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "1.0.0-next.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "21.0.4",
		"@j178/prek": "0.5.7",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@opentelemetry/context-async-hooks": "3.0.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
		"@opentelemetry/resources": "3.0.0",
		"@opentelemetry/sdk-trace": "3.0.0",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/package": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/bun": "1.4.4",
		"markdownlint-cli2": "0.24.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"publint": "0.3.25",
		"shiki": "4.5.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"tailwint": "1.1.16",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"zod": "4.6.7"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"shadcn-svelte",
		"tailwindcss"
	]
}
